# Salin file ini menjadi .env.local lalu isi dengan nilai dari
# Firebase Console > Project Settings > General > Your apps > SDK setup and configuration.
# Nilai-nilai ini bersifat PUBLIK (dibundel ke frontend) — keamanan sesungguhnya
# ada di Firestore/Storage Security Rules dan Cloud Functions, bukan di sini.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Site key dari Firebase Console > App Check > reCAPTCHA v3 provider.
# Kosongkan saat development jika belum di-setup (App Check akan dilewati).
VITE_RECAPTCHA_SITE_KEY=

# Set "true" untuk memakai Firebase Emulator Suite lokal (npm run emulators).
VITE_USE_EMULATORS=false
