rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Metadata dokumen yang aman dibaca publik (TIDAK berisi storagePath —
    // lihat documentStorage di bawah untuk alasan pemisahan ini).
    match /documents/{docId} {
      allow read: if isAdmin() || resource.data.isPublic == true;
      allow write: if false; // seluruh write wajib lewat Cloud Functions (Admin SDK)
    }

    // Path Storage asli. TIDAK PERNAH boleh dibaca langsung oleh client mana pun,
    // termasuk admin — Cloud Functions yang membaca ini lewat Admin SDK
    // (Admin SDK melewati Security Rules sepenuhnya).
    match /documentStorage/{docId} {
      allow read, write: if false;
    }

    // Hash kode + riwayat penggunaan. Validasi kode HANYA terjadi di
    // redeemVerificationCode (Cloud Function), tidak pernah di client.
    match /verificationCodes/{codeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Counter rate-limit internal, tidak relevan untuk dibaca siapa pun.
    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }
  }
}
